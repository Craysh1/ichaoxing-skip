    shadow.innerHTML='<style>:host{position:fixed;right:16px;bottom:16px;z-index:2147483647;font:13px/1.6 system-ui;color:#e8f0ff}section{width:300px;padding:16px;background:#17243a;border:1px solid #456;border-radius:14px;box-shadow:0 8px 30px #0005}button{padding:5px 9px;margin:4px;border:0;border-radius:6px;background:#67d9ba;cursor:pointer}textarea{box-sizing:border-box;width:100%;height:70px;margin-top:8px}p{margin:8px 0;white-space:pre-wrap}</style><section><b>学习助手 · 聊天回传</b><p id="state"></p><button id="copy">复制题目</button><button id="retry">重新尝试填入</button><details><summary>手动粘贴回答回传</summary><textarea placeholder="粘贴含 request_id 的 JSON 回答"></textarea><button id="return">回传回答</button></details></section>';
    const state=shadow.querySelector('#state');
    const light=document.createElement('style');light.textContent=':host{color:#263247;color-scheme:light}section{background:#fff;border-color:#dbe3ee;box-shadow:0 8px 30px #24344e24}button{background:#2878ef;color:white}textarea{background:white;color:#263247;border:1px solid #d7e0eb;border-radius:6px;padding:8px}';shadow.append(light);
    const images=request.images||[];
    const bind=document.createElement('button');bind.textContent='绑定当前对话';shadow.querySelector('section').append(bind);
    bind.onclick=()=>{const url=rememberChannel();setState(url?'已保存当前对话链接；请确认官网名称为“学习通刷课搜题”。':'当前还没有具体对话链接，请先登录并发送一题。');};
    for(const attachment of images){const a=document.createElement('a');a.href=attachment.dataURL;a.download=attachment.name;a.textContent=`下载图片：${attachment.name}`;a.style.cssText='display:block;color:#2878ef;overflow-wrap:anywhere';shadow.querySelector('section').append(a);}
    const confirmImages=document.createElement('button');confirmImages.textContent='官网已附上全部图片，继续';confirmImages.hidden=!images.length;shadow.querySelector('section').append(confirmImages);
    confirmImages.onclick=()=>{upload.phase='ready';setState('已确认附件，继续发送。');};
    let routed=false, routeAt=Date.now(), renamePhase='idle', renameAt=0, renameStarted=0, renameRow=null;
    const upload={phase:images.length?'new':'ready',at:0,before:new Set()};
    function channelLinks(){return [...document.querySelectorAll('a[href]')].filter(a=>validChannelURL(a.href,provider));}
    function rememberChannel(){
      const url=validChannelURL(location.href,provider);if(!url)return null;
      const named=channelLinks().some(a=>validChannelURL(a.href,provider)===url&&(a.textContent.trim()===CHANNEL_NAME||a.getAttribute('title')===CHANNEL_NAME));
      const old=GM_getValue(`cx-channel:${provider}`,null);
      if(old?.url!==url||old.nameVerified!==named)GM_setValue(`cx-channel:${provider}`,{url,nameVerified:named});
      return url;
    }
    function prepareChannel(){
      if(!renameStarted)renameStarted=Date.now();
      const url=rememberChannel();
      if(!url){setState('答案已生成，但对话链接尚未保存；请登录并在具体对话中使用。');return true;}
      const saved=GM_getValue(`cx-channel:${provider}`,null);if(saved?.nameVerified)return true;
      if(Date.now()-renameStarted>12000){renamePhase='done';return true;}
      if(renamePhase==='done')return true;
      if(renamePhase==='idle'){
        const anchor=channelLinks().find(a=>validChannelURL(a.href,provider)===url);
        renameRow=anchor?.closest('li,[data-testid*="history-item"]')||anchor?.parentElement;
        const buttons=renameRow?[...renameRow.querySelectorAll('button')]:[];
        const menu=buttons.find(b=>/more|options|menu|更多|选项|菜单/i.test(b.getAttribute('aria-label')||b.getAttribute('title')||''))||(buttons.length===1?buttons[0]:null);
        if(!menu){
          const open=[...document.querySelectorAll('button[data-testid="open-sidebar-button"],button[aria-label="Open sidebar"],button[aria-label="打开边栏"],button[aria-label="展开侧边栏"]')].find(seen);
          if(open){open.click();renamePhase='sidebar';renameAt=Date.now();return false;}
          renamePhase='done';return true;
        }
        menu.click();renamePhase='menu';renameAt=Date.now();setState('正在将专用对话命名为“学习通刷课搜题”…');return false;
      }
      if(renamePhase==='sidebar'){
        if(channelLinks().some(a=>validChannelURL(a.href,provider)===url)){renamePhase='idle';return false;}
      }else if(renamePhase==='menu'){
        const rename=[...document.querySelectorAll('[role="menuitem"],button')].find(b=>seen(b)&&/^(Rename|重命名)$/i.test(b.textContent.trim()));
        if(rename){rename.click();renamePhase='edit';renameAt=Date.now();return false;}
      }else if(renamePhase==='edit'){
        const dialog=[...document.querySelectorAll('[role="dialog"]')].find(seen);
        const input=(dialog||renameRow)?.querySelector('input[type="text"],input:not([type]),textarea');
        if(input&&seen(input)){
          const proto=input instanceof HTMLTextAreaElement?HTMLTextAreaElement.prototype:HTMLInputElement.prototype;
          Object.getOwnPropertyDescriptor(proto,'value').set.call(input,CHANNEL_NAME);input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));
          const save=[...(dialog||renameRow).querySelectorAll('button')].find(b=>seen(b)&&/^(Save|保存|确认|确定)$/i.test(b.textContent.trim()));
          if(save)save.click();else input.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',bubbles:true}));
          renamePhase='verify';renameAt=Date.now();return false;
        }
      }
      if(Date.now()-renameAt>3500){renamePhase='done';rememberChannel();return true;}
      return false;
    }
    function uploadImages(input){
      if(upload.phase==='ready')return true;
      const scope=input.closest('form,#composer-background,[data-testid*="composer"],[class*="chat-input"]')||input.parentElement?.parentElement||document.body;
      const previews=()=>{
        const nodes=[...scope.querySelectorAll('[data-testid*="attachment"],[data-testid*="file"],.attachment-preview,img[src^="blob:"],img[src^="data:image/"]')].filter(seen);
        return nodes.filter(el=>!nodes.some(other=>other!==el&&other.contains(el)));
      };
      if(upload.phase==='new'){
        if(previews().length){setState('官网输入区已有附件，未继续添加。请清理旧附件，或确认全部附件确实属于本题后点击下方继续。');return false;}
        upload.before=new Set(previews());upload.at=Date.now();upload.phase='waiting';
        const transfer=new DataTransfer();
        for(const image of images){const bytes=Uint8Array.from(atob(image.dataURL.split(',')[1]),c=>c.charCodeAt(0));transfer.items.add(new File([bytes],image.name,{type:image.type}));}
        const inputs=[...document.querySelectorAll('input[type="file"]')].filter(el=>!el.disabled&&!el.webkitdirectory);
        const picker=inputs.find(el=>/image|\.png|\.jpe?g|\.webp|\.gif/i.test(el.accept))||inputs.find(el=>!el.accept||el.accept==='*/*');
        try{
          if(picker){picker.files=transfer.files;picker.dispatchEvent(new Event('change',{bubbles:true}));}
          else input.dispatchEvent(new ClipboardEvent('paste',{bubbles:true,cancelable:true,clipboardData:transfer}));
        }catch{setState('无法自动附图，请下载下方图片，在官网添加后点击确认。');return false;}
      }
      const fresh=previews().filter(el=>!upload.before.has(el));
      const uploading=[...scope.querySelectorAll('progress,[role="progressbar"],[aria-busy="true"]')].some(seen);
      if(fresh.length>=images.length&&!uploading&&Date.now()-upload.at>2000){upload.phase='ready';return true;}
      setState(Date.now()-upload.at>15000?'尚未确认全部图片附件。请在官网手动添加图片，确认后点击下方继续。':'正在添加图片，等待附件预览；暂不发送文字。');return false;
    }
    let filled=sessionStorage.getItem(`cx-filled:${id}`)==='yes', sent=sessionStorage.getItem(`cx-sent:${id}`)==='yes', last='', stableAt=0, finished=false;
    const setState=text=>{if(state.textContent!==text)state.textContent=text;};
    const returnAnswer=answer=>{
      if (finished || !GM_getValue(`cx-request:${id}`,null)) return;
      GM_setValue(`cx-response:${id}`,answer);finished=true;
      const saved=GM_getValue(`cx-channel:${provider}`,null);
      setState(`答案已回传，学习通将尝试关闭本标签页并返回。${saved?.nameVerified?'':' 对话改名未确认，请在官网手动命名为“学习通刷课搜题”。'}`);
    };
    shadow.querySelector('#copy').onclick=()=>{GM_setClipboard(request.prompt);setState('题目已复制，可粘贴到聊天框并发送。');};
    shadow.querySelector('#retry').onclick=()=>{filled=false;sent=false;sessionStorage.removeItem(`cx-filled:${id}`);sessionStorage.removeItem(`cx-sent:${id}`);setState('将在空白聊天输入框中重试；不会覆盖已有文字。');};
    shadow.querySelector('#return').onclick=()=>{const answer=parseResponse(shadow.querySelector('textarea').value,id);if(answer){rememberChannel();returnAnswer(answer);}else setState('格式不匹配，请粘贴本次题目对应的完整 JSON 回答。');};
    const busy=()=>[...document.querySelectorAll('[data-testid="stop-button"],button[aria-label*="Stop"],button[aria-label*="停止"],.ds-icon-button')].some(el=>seen(el)&&/stop|停止/i.test(el.getAttribute('aria-label')||el.getAttribute('data-testid')||''));
    const timer=setInterval(()=>{
      if(finished){clearInterval(timer);return;}
      if(!GM_getValue(`cx-request:${id}`,null)||Date.now()-request.created>600000){setState('请求已取消或过期。');clearInterval(timer);return;}
      if(!routed){
        if(validChannelURL(location.href,provider)){routed=true;rememberChannel();}
        else{
          const ready=[...document.querySelectorAll('#prompt-textarea,textarea:not([disabled]),[contenteditable="true"][role="textbox"]')].some(seen);
          if(!ready){routeAt=Date.now();setState('请先登录，登录后查找固定对话。');return;}
          if(Date.now()-routeAt<3000)return;
          const named=channelLinks().find(a=>a.textContent.trim()===CHANNEL_NAME||a.getAttribute('title')===CHANNEL_NAME);
          if(named){const url=validChannelURL(named.href,provider);GM_setValue(`cx-channel:${provider}`,{url,nameVerified:true});const target=new URL(url);target.searchParams.set('cx_helper',id);location.assign(target.href);return;}
          routed=true;
        }
      }
      const userSelector='[data-message-author-role="user"],[data-message-role="user"],[data-role="user"],[data-testid="user-message"],.user-message,[contenteditable="true"],textarea';
      const replySelector=provider==='chatgpt'?'[data-message-author-role="assistant"],[data-message-role="assistant"],[data-role="assistant"],.agent-turn,.assistant-message,.markdown,.prose,pre':'.ds-markdown,.markdown,.assistant-message,pre';
      const acceptable=el=>{
        if(!seen(el)||el.closest(userSelector))return false;
        const text=el.innerText||'';
        if(text.includes('下面内容是题目资料')||text.includes('请解答下面的学习题'))return false;
        const answer=parseResponse(text,id);
        return !!answer&&answer.explanation!=='解释';
      };
      let reply=[...document.querySelectorAll(replySelector)].reverse().find(acceptable);
      // 新版网页可能没有 assistant 类名：仅接受独立完整 JSON 块，绝不读取整页当回答。
      if(!reply){
        const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let node;
        const candidates=new Set();
        while((node=walker.nextNode()))if(node.textContent.includes('request_id')){
          let el=node.parentElement;for(let n=0;el&&el!==document.body&&n<4;n++,el=el.parentElement){
            const text=(el.innerText||'').trim();
            if(/^(?:```(?:json)?\s*)?\{/.test(text)&&text.endsWith('}')||/^```json[\s\S]*```$/.test(text))candidates.add(el);
          }
        }
        reply=[...candidates].reverse().find(acceptable);
      }
      if(reply){
        const text=reply.innerText;
        if(text!==last){last=text;stableAt=Date.now();}
        if(!busy()&&Date.now()-stableAt>=5000){if(prepareChannel())returnAnswer(parseResponse(text,id));return;}
        setState('检测到本次回答，等待生成稳定后回传…');return;
      }
      if(sent){setState('等待回答。若网页无法自动回传，请展开下方手动回传。');return;}
      const input=[...document.querySelectorAll('#prompt-textarea,textarea:not([disabled]),[contenteditable="true"][role="textbox"]')].find(seen);
      if(!input){setState('请在官网登录并打开聊天输入框。会员状态请在官网查看。');return;}
      const value=input instanceof HTMLTextAreaElement?input.value:input.innerText;
      if(!uploadImages(input))return;
      if(!filled){
        if(value.trim() && value.trim()!==request.prompt.trim()){setState('输入框已有内容，未覆盖。请复制题目后自行发送。');return;}
        if(!value.trim()){
          input.focus();
          if(input instanceof HTMLTextAreaElement)Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(input,request.prompt);
          else {input.textContent=request.prompt;}
          input.dispatchEvent(new InputEvent('input',{bubbles:true,inputType:'insertText',data:request.prompt}));
        }
        filled=true;sessionStorage.setItem(`cx-filled:${id}`,'yes');setState('已填入题目，等待发送按钮…');return;
      }
      if(value.trim()!==request.prompt.trim()){setState('题目可能已手动发送，正在等待回答…');return;}
      const buttons=[...document.querySelectorAll('[data-testid="send-button"],button[aria-label*="Send"],button[aria-label*="发送"],button[type="submit"]')].filter(b=>seen(b)&&!b.disabled&&b.getAttribute('aria-disabled')!=='true');
      const sendButton=buttons.find(b=>b.getAttribute('data-testid')==='send-button') || (buttons.length===1?buttons[0]:null);
      if(!sendButton||busy()){setState('请手动点击官网的发送按钮，回答生成后会尝试回传。');return;}
      sent=true;sessionStorage.setItem(`cx-sent:${id}`,'yes');sendButton.click();setState('已点击发送，等待回答…');
    },1000);
  }
  discover();
  if (isTop) { mount(); log('助手已加载；等待视频及任务点状态'); }
  setInterval(() => {
    discover();
    const rows = snapshot();
    const previous=questions.map(q=>q.id).join('|');questions=scanQuestions();continueCorrectQuiz();
    if (!isTop) send(parent, { type: 'snapshot', instance:instanceId, rows, questions });
    else {
      records = rows;
      if(questions.length && previous!==questions.map(q=>q.id).join('|'))log('检测到视频弹题，暂停续播，等待答题');
      checkAnswer();control();
      if(running&&settings.autoAnswer&&!pendingRequest){const q=questions.find(q=>!requestedQuestions.has(q.id));if(q)startSearch(q);}
      render(tab==='答题'&&previous!==questions.map(q=>q.id).join('|'));
    }
  }, 1000);
