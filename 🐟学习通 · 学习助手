      const scope=composerScope(input);
      const enabled=b=>seen(b)&&!b.disabled&&b.getAttribute('aria-disabled')!=='true'&&!/disabled/.test(b.className||'')&&getComputedStyle(b).pointerEvents!=='none';
      const selector='#composer-submit-button,[data-testid="send-button"],[data-testid="send-message-button"],button[aria-label*="Send"],button[aria-label*="发送"]';
      let candidates=[...scope.querySelectorAll(selector)].filter(seen);
      if(!candidates.length)candidates=[...document.querySelectorAll(selector)].filter(seen);
      if(provider==='deepseek'&&!candidates.length)candidates=[...scope.querySelectorAll('[role="button"].ds-button--primary.ds-button--circle,.ds-icon-button--primary,[role="button"][aria-label*="发送"],[role="button"][aria-label*="Send"]')].filter(seen);
      if(!candidates.length&&input.closest('form'))candidates=[...input.closest('form').querySelectorAll('button[type="submit"]')].filter(seen);
      if(candidates.some(b=>/stop|停止/i.test(b.getAttribute('aria-label')||b.getAttribute('data-testid')||'')||(provider==='deepseek'&&b.querySelector('svg rect')))){setState('聊天页仍在生成，等待发送入口恢复。');return;}
      const buttons=candidates.filter(enabled);
      if(candidates.length&&!buttons.length){
        if(Date.now()-lastFillAt>8000&&!images.length&&fillAttempts<3)fillComposer(input);
        setState('发送按钮尚未启用，等待网页就绪；未消耗发送重试次数。');return;
      }
      const sendButton=buttons.find(b=>b.getAttribute('data-testid')==='send-button') || (buttons.length===1?buttons[0]:null);
      if(buttons.length>1&&!sendButton){setState('发送入口不唯一，请手动发送本题。');return;}
      sendAttempts++;lastSendAt=Date.now();
      if(sendButton)sendButton.click();
      else {input.focus();for(const type of ['keydown','keypress','keyup'])input.dispatchEvent(new KeyboardEvent(type,{key:'Enter',code:'Enter',keyCode:13,which:13,bubbles:true,cancelable:true}));}
      setState(`第 ${sendAttempts} 次尝试发送，正在确认是否进入聊天记录…`);
    },1000);
  }
  discover();
  if (isTop) { mount(); log('助手已加载；等待视频及任务点状态'); }
  setInterval(() => {
    discover();
    const rows = snapshot();
    const previous=questions.map(q=>q.id).join('|');questions=scanQuestions();continueCorrectQuiz();
    if(settings.practiceSubmit&&settings.selfAnswer&&(isTop?running:settings.sessionRunning===true)&&Date.now()<submitConfirmUntil)confirmKnownSubmit();
    scrollDocumentTask();
    if (!isTop) send(parent, { type: 'snapshot', instance:instanceId, rows, questions, courses:courseSnapshot(), outline:outlineSnapshot(), tasks:pageTaskState() });
    else {
      if(selectionCapture&&Date.now()-selectionCapture.at>45000){selectionCapture=null;searchResult='选区截图超时，已停止重试。';render(true);}
      updateCourseCatalog();
      records = rows;
      if(questions.length && previous!==questions.map(q=>q.id).join('|'))log('检测到视频弹题，暂停续播，等待答题');
      checkAnswer();control();
      tickPractice();
      maybeSubmitPractice();
      if(running&&settings.autoAnswer&&!pendingRequest&&!preparingPractice&&!pendingFill){const q=questions.find(q=>q.kind!=='practice'&&!requestedQuestions.has(q.id));if(q)startSearch(q);}
      render(tab==='答题'&&previous!==questions.map(q=>q.id).join('|'));
    }
  }, 1000);
})();
