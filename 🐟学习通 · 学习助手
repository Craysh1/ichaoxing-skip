// ==UserScript==
// @name         学习通 · 视频学习助手
// @namespace    local.chaoxing.study
// @version      1.0.0
// @description  浮窗、视频队列、静音、暂停续播和任务完成后切换。
// @match        *://*.chaoxing.com/*
// @match        https://chatgpt.com/*
// @match        https://chat.deepseek.com/*
// @run-at       document-idle
// @require      https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_openInTab
// @grant        GM_setClipboard
// @grant        GM_addValueChangeListener
// @grant        GM_removeValueChangeListener
// @grant        GM_getTab
// @grant        GM_saveTab
// @grant        unsafeWindow
// ==/UserScript==

(() => {
  'use strict';
  const VERSION = '1.0.0';
  const CHANNEL_NAME = '学习通刷课搜题';
  const providers = { chatgpt: 'https://chatgpt.com/', deepseek: 'https://chat.deepseek.com/' };
  const isChat = ['chatgpt.com', 'chat.deepseek.com'].includes(location.hostname);
  if (isChat) { if (window === top) startChatBridge(); return; }
  // 只在学习页面显示窗口，子框架通过父框架统一调度。
  const isCX = /(^|\.)chaoxing\.com$/.test(location.hostname);
  const isTop = window === window.top;
  if (isTop && (!isCX || !/studentstudy|studentcourse|stucoursemiddle|\/knowledge\/cards|\/ananas\/modules\/video|^\/base\b|\/visit\/courses|\/space\/index|\/work(?:\/|$)|\/exam(?:\/|$)/i.test(location.pathname))) return;
  const CHANNEL = 'cx-study-helper-v1';
  const instanceId = crypto.randomUUID();
  const defaults = { autoStart: true, muted: true, resume: true, next: true, delay: 3, nextSelector: '', autoAnswer: false, autoSubmit: false, selectionSearch: false, provider: 'chatgpt', quizSelector: '', optionSelector: '', submitSelector: '' };
  let settings = { ...defaults, ...GM_getValue('settings', {}) };
  settings = {selfAnswer:false, answerDelay:3, multiDelay:0.3, practiceSubmit:false, ...settings};
  let running = settings.autoStart;
  const allFeatureKeys=['autoStart','muted','resume','next','autoAnswer','autoSubmit','selectionSearch','selfAnswer','practiceSubmit'];
  let operationEpoch=0;
  function toggleAllFeatures(enabled){
    operationEpoch++;
    for(const key of allFeatureKeys)settings[key]=enabled;
    running=enabled;navigation=null;navigationLock=false;submitConfirmUntil=0;
    if(!enabled){
      const interrupted=[preparingPractice?.question?.id,pendingFill?.question?.id,pendingRequest?.question?.id].filter(Boolean);
      if(pendingRequest||selectionCapture)cancelSearch('总开关已关闭，取消待处理搜题');
      preparingPractice=null;pendingFill=null;selectionCapture=null;
      for(const id of interrupted){practiceStates.delete(id);requestedQuestions.delete(id);}
      try{chatTab?.close?.();}catch{}chatTab=null;
      GM_setValue('cx-course-run',null);courseTransition=false;completeSince=0;
    }
    GM_setValue('settings',settings);
    command(null,false,settings);
    if(enabled){
      if((GM_getValue('cx-course-order',[])||[]).length)beginCourseQueue();
      control(true);
    }
    log(enabled?'全部功能已开启（含自动答题与提交）':'全部功能已关闭，课程队列及待处理操作已停止');render(true);
  }
  let active = null, records = [], navigation = null, navigationLock = false;
  const local = new Map(), children = new Map(), logs = [];
  let serial = 0, childSerial = 0, root, tab = '首页';
  let questions = [], localQuestions = [], quizSerial = 0, searchText = '', searchResult = '', pendingRequest = null, responseListener = null;
  let searchImages = [], imageLoading = false, chatTab = null;
  let queueTabId=null, courseTransition=false, completeSince=0;
  if(isTop){
    if(typeof GM_getTab==='function')GM_getTab(data=>{if(!data.cxQueueTab){data.cxQueueTab=crypto.randomUUID();GM_saveTab(data);}queueTabId=data.cxQueueTab;});
    else {queueTabId=sessionStorage.getItem('cx-queue-tab')||crypto.randomUUID();sessionStorage.setItem('cx-queue-tab',queueTabId);}
  }
  const requestedQuestions = new Set(), answeredQuestions = new Set(), appliedRequests = new Set(), continuedQuestions = new Set();
  const practiceStates = new Map();
  let preparingPractice=null, pendingFill=null;
  let submitConfirmUntil=0;
  let selectionSource=null, searchSelection=null, selectionCapture=null;
  const boot = Date.now();
  const send = (target, payload) => target.postMessage({ channel: CHANNEL, ...payload }, '*');
  const visible = el => !!el && el.isConnected && el.getClientRects().length > 0 && getComputedStyle(el).visibility !== 'hidden';
  const finished = box => !!box && (box.matches('.ans-job-finished') || !!box.querySelector('.ans-job-finished,.ans-job-icon[aria-label="任务点已完成"]'));
  const taskBox = el => el.closest('.ans-attach-ct, .ans-job');
  const allowedOrigin = origin => { try { return /(^|\.)(chaoxing\.com|edu\.cn)$/.test(new URL(origin).hostname); } catch { return false; } };
  const log = (message, level = /错误|未成功|失败/.test(message) ? 'error' : /未找到|未检测|阻止|等待|暂停/.test(message) ? 'warn' : 'info') => {
    if (!isTop) { send(parent, { type: 'log', message, level }); return; }
    if (logs.at(-1)?.message === message) return;
    logs.push({ time: new Date().toLocaleTimeString(), message, level }); if (logs.length > 200) logs.shift();
  };
  function discover() {
    for (const v of document.querySelectorAll('video')) {
      if (local.has(v)) continue;
      const item = { id: `v${++serial}`, v, controlled: false, pending: false, failed: '', endedAt: 0, timer: null, nextAttempt: 0, attempts: 0, blocked: false };
      local.set(v, item);
      v.addEventListener('pause', () => {
        if (!item.controlled || !settings.resume || v.ended || v.error || item.timer) return;
        item.timer = setTimeout(() => {
          item.timer = null;
          if (!item.controlled || !settings.resume || !v.paused || v.ended || v.error) return;
          play(item);
        }, 350);
      });
      v.addEventListener('error', () => {
        clearTimeout(item.timer); item.timer = null;
        log(`视频错误 ${v.error?.code || 0}；已停止对此视频尝试播放。诊断：${JSON.stringify(diagnostic(item))}`);
      });
      v.addEventListener('ended', () => { item.endedAt = Date.now(); });
    }
    for (const [v] of local) if (!v.isConnected) local.delete(v);
  }
  async function play(item) {
    const v = item.v;
    if (!item.controlled || !v.isConnected || !v.paused || v.ended || v.error || item.pending || item.blocked || Date.now() < item.nextAttempt || hasQuiz()) return;
    item.nextAttempt = Date.now() + 2500;
    item.pending = true;
    v.muted = settings.muted;
    v.playsInline = true;
    try {
      item.attempts++;
      const player = v.closest('.video-js');
      const button = player && [...player.querySelectorAll('.vjs-play-control, .vjs-big-play-button')].find(b => visible(b) && !b.disabled);
      // 优先走播放器自己的播放按钮；一次尝试不再追加第二次 play()。
      if (button) button.click(); else await v.play();
      item.failed = '';
    }
    catch (e) {
      const message = e.name === 'NotAllowedError' ? '浏览器阻止自动播放，请手动点击一次视频播放按钮' : `播放未成功：${e.name}`;
      if (e.name === 'NotAllowedError') item.blocked = true;
      if (item.failed !== message) log(message);
      item.failed = message;
    } finally { item.pending = false; }
  }
  function diagnostic(item) {
    const v = item.v;
    return { code: v.error?.code || 0, readyState: v.readyState, networkState: v.networkState,
      time: Math.round(v.currentTime || 0), paused: v.paused, ended: v.ended, attempts: item.attempts };
  }
  function queryAll(scope, selector) { try { return [...scope.querySelectorAll(selector)]; } catch { return []; } }
  function courseIdentity(value) {
    try{const url=new URL(value,location.href);if(!/(^|\.)chaoxing\.com$/.test(url.hostname)||!/^https?:$/.test(url.protocol))return null;
      const params=Object.fromEntries([...url.searchParams].map(([k,v])=>[k.toLowerCase(),v]));
      if(!params.courseid)return null;
      return {id:`${params.courseid}:${params.clazzid||params.classid||''}`,courseId:params.courseid,clazzId:params.clazzid||params.classid||'',url:url.href};
    }catch{return null;}
  }
  function sameCourse(a,b){return !!a&&!!b&&a.courseId===b.courseId&&(!a.clazzId||!b.clazzId||a.clazzId===b.clazzId);}
  function collectCourses(){
    if(!(/^i\./.test(location.hostname)||/\/visit\/courses|\/space\/index/.test(location.pathname)||document.querySelector('#courseList li.course')))return [];
    const result=new Map();
    for(const a of queryAll(document,'a[href]')){
      const course=courseIdentity(a.href);
      if(!course||!/studentcourse|studentstudy|stucoursemiddle/i.test(a.href))continue;
      const card=a.closest('li.course');
      const name=(card?.querySelector('.course-name')?.textContent||a.getAttribute('title')||a.querySelector('h3,h4,.course-name,.courseName')?.textContent||a.textContent.trim()||a.querySelector('img')?.alt||'').trim().replace(/\s+/g,' ');
      if(name && name.length<=200)result.set(course.id,{...course,name});
    }
    return [...result.values()];
  }
  function collectOutline(){
    const catalog=catalogTasks();
    if(catalog.length)return {total:catalog.length,done:catalog.filter(el=>catalogState(el)==='done').length};
    const all=queryAll(document,'.ncells,.chapter_item,.chapter-item,[data-knowledgeid]');
    const rows=all.filter(el=>!all.some(other=>other!==el&&el.contains(other)));
    return {total:rows.length,done:rows.filter(el=>!!el.querySelector('.ans-job-icon[aria-label="任务点已完成"],[aria-label="已完成"]')||el.getAttribute('aria-label')==='已完成').length};
  }
  function updateCourseCatalog(){
    const found=courseSnapshot();
    if(!found.length)return;
    const saved=GM_getValue('cx-course-catalog',[]),map=new Map(saved.map(c=>[c.id,c]));
    for(const item of found){const course=courseIdentity(item.url);if(course&&typeof item.name==='string')map.set(course.id,{...course,name:item.name.slice(0,200)});}
    const next=[...map.values()].slice(-500);if(JSON.stringify(saved)!==JSON.stringify(next))GM_setValue('cx-course-catalog',next);
  }
  function courseSnapshot(){return [...collectCourses(),...[...children.values()].filter(c=>Date.now()-c.at<6000).flatMap(c=>c.courses||[])];}
  function outlineSnapshot(){const items=[collectOutline(),...[...children.values()].filter(c=>Date.now()-c.at<6000).map(c=>c.outline).filter(Boolean)];return items.reduce((sum,o)=>({total:sum.total+o.total,done:sum.done+o.done}),{total:0,done:0});}
  function queueRun(){return GM_getValue('cx-course-run',null);}
  function beginCourseQueue(){
    if(!queueTabId){log('正在初始化课程队列，请稍候','warn');return;}
    courseTransition=false;completeSince=0;
    const order=GM_getValue('cx-course-order',[]),catalog=GM_getValue('cx-course-catalog',[]);
    const current=courseIdentity(location.href);
    if(current){GM_setValue('cx-course-run',{owner:queueTabId,current});log('已启用队列：确认当前课程全部任务完成后切换');running=true;render(true);return;}
    const first=catalog.find(c=>c.id===order[0]);if(!first){log('请先勾选课程','warn');return;}
    GM_setValue('cx-course-run',{owner:queueTabId,current:first});location.assign(first.url);
  }
  function advanceCourse(manual=false){
    const run=queueRun();if(!run||run.owner!==queueTabId||courseTransition)return false;
    if(!sameCourse(courseIdentity(location.href),run.current)){log('当前页面无法对应队列课程，未切换','warn');return false;}
    const catalog=GM_getValue('cx-course-catalog',[]),order=GM_getValue('cx-course-order',[]).filter(id=>!sameCourse(catalog.find(c=>c.id===id),run.current));
    const next=catalog.find(c=>c.id===order[0]);
    GM_setValue('cx-course-order',order);courseTransition=true;command(null,false,settings);
    if(!next){GM_setValue('cx-course-run',null);running=false;log('课程队列已完成');render(true);return true;}
    log(`${manual?'已手动确认':'已确认'}当前课程完成，进入：${next.name}`);
    GM_setValue('cx-course-run',{owner:queueTabId,current:next});location.assign(next.url);return true;
  }
  function handleCourseQueue(){
    const run=queueRun();if(!run||run.owner!==queueTabId||!sameCourse(courseIdentity(location.href),run.current)||courseTransition)return false;
    const own=collectOutline(),outlines=[own,...[...children.values()].filter(c=>Date.now()-c.at<6000).map(c=>c.outline).filter(Boolean)];
    const known=outlines.filter(o=>o.total>0);
    const complete=known.length>0&&known.every(o=>o.done===o.total)&&!nextButton()&&!questions.length&&records.every(r=>r.done);
    if(complete){if(!completeSince)completeSince=Date.now();if(Date.now()-completeSince>=4000)return advanceCourse();}else completeSince=0;
    if(!records.length&&!/studentstudy|\/knowledge\/cards|\/ananas\/modules\/video/i.test(location.pathname)&&Date.now()-boot>4000){
      const entry=queryAll(document,'a[href]').find(a=>/studentstudy/i.test(a.href)&&sameCourse(courseIdentity(a.href),run.current));
      if(entry){courseTransition=true;location.assign(entry.href);return true;}
    }
    return false;
  }
  function quizBoxes() {
    const known = queryAll(document, settings.quizSelector || '.ans-videoquiz-container,.ans-videoquiz,.videoquiz,.vjs-quiz,.quiz-container,[role="dialog"]');
    for (const input of queryAll(document, 'input[type="radio"],input[type="checkbox"],[role="radio"]')) {
      let box = input.parentElement;
      for (let n = 0; box && box !== document.body && n < 7; n++, box = box.parentElement) {
        if (/判断题|单选题|多选题/.test(box.innerText || '') && queryAll(box, 'button,input[type="submit"],a,[role="button"]').some(b => /^(提交|确定|提交答案)$/.test((b.innerText || b.value || '').trim()))) { known.push(box); break; }
      }
    }
    return [...new Set(known)].filter(visible);
  }
  function hasQuiz() { return quizBoxes().some(box => /判断题|单选题|多选题|提交答案/.test(box.innerText || '') || !!settings.quizSelector); }
  function scanQuestions() {
    const found = [];
    for (const box of quizBoxes()) {
      if(box.closest('.TiMu,.questionLi,.question-item,.mark_table')||box.querySelector('.TiMu,.questionLi,.question-item,.mark_table'))continue;
      let inputs = queryAll(box, settings.optionSelector || 'input[type="radio"],input[type="checkbox"],[role="radio"],[role="checkbox"]');
      inputs = inputs.filter(el => visible(el) || visible(el.closest('label')));
      if (inputs.length < 2 || inputs.length > 10 || found.some(q=>q.box.contains(box) || box.contains(q.box))) continue;
      const options = inputs.map((el, i) => {
        const label = el.labels?.[0] || el.closest('label') || el.parentElement;
        return { letter:String.fromCharCode(65+i), text:(el.getAttribute('aria-label') || label?.innerText || '').trim().replace(/^[A-J][、.．]\s*/,''), el };
      });
      if (options.some(o=>!o.text) || new Set(options.map(o=>o.text)).size !== options.length) continue;
      const heading = queryAll(box, '.tkItem_title,.ans-videoquiz-title,.question-title,.quiz-title,[data-question]').find(visible);
      let stem = heading?.innerText?.trim() || box.innerText.trim();
      if (!heading) { for (const option of options) stem = stem.replace(option.text, ''); stem = stem.replace(/提交答案|提交|确定/g, '').trim(); }
      if (!stem || stem.length > 4000) continue;
      const signature = JSON.stringify([stem, options.map(o=>o.text)]);
      const old = localQuestions.find(q=>q.box === box && q.signature === signature);
      found.push({ id:old?.id || `q${++quizSerial}`, box, signature, stem, options, multiple: inputs.every(el=>el.type === 'checkbox' || el.getAttribute('role') === 'checkbox') });
    }
    found.push(...scanPractice());
    localQuestions = found;
    const result = found.map(q=>({id:q.id, signature:q.signature, stem:q.stem, multiple:q.multiple, kind:q.kind, filled:q.filled, complete:q.kind==='practice'&&(q.blanks.length?q.blanks.every(el=>blankValue(el)):q.options.some(optionSelected)), encrypted:q.encrypted, blanks:q.blanks?.length||0, imageCount:q.media?.length||0, options:q.options.map(({letter,text})=>({letter,text}))}));
    for (const child of children.values()) {
      const frame = queryAll(document, 'iframe,frame').find(f=>f.contentWindow===child.win);
      if (!visible(frame) || Date.now()-child.at>6000) continue;
      for (const q of child.questions || []) result.push({...q,id:`${child.id}/${q.id}`});
    }
    return result;
  }
  const blankEditors=new WeakMap();
  function blankValue(el){
    const binding=blankEditors.get(el);
    if(binding?.editor?.getContentTxt)return binding.editor.getContentTxt().trim();
    return (el.value??el.innerText??'').trim();
  }
  function editorBlanks(box){
    const result=[];
    for(const frame of queryAll(box,'.blankItemInp .edui-editor-iframeholder iframe')){
      if(!visible(frame))continue;
      try{
        const body=frame.contentDocument?.body;if(!body)continue;
        const owner=typeof unsafeWindow!=='undefined'?unsafeWindow:window;
        const editor=Object.values(owner.UE?.instants||{}).find(item=>item?.iframe===frame||item?.document===frame.contentDocument);
        const holder=frame.closest('.blankItemInp'),textarea=holder?.querySelector('textarea[id^="answerEditor"]'),mirror=holder?.querySelector('.InpDIV');
        if(!textarea)continue;
        blankEditors.set(body,{frame,editor,textarea,mirror});result.push(body);
      }catch{/* 未就绪或无法访问的编辑器不视为普通输入框。 */}
    }
    return result;
  }
  function writeBlank(el,value){
    const binding=blankEditors.get(el);
    if(binding){
      const {editor,frame,textarea,mirror}=binding;
      if(!frame.isConnected||!visible(frame)||editor?.isReady===false||typeof editor?.setContent!=='function'||typeof editor?.getContentTxt!=='function'||typeof editor?.sync!=='function')throw Error('填空编辑器尚未就绪或无法同步，未填入');
      const escaped=document.createElement('div');escaped.textContent=value;
      editor.setContent(escaped.innerHTML.replace(/\n/g,'<br>'));editor.sync();
      const text=html=>{const node=document.createElement('div');node.innerHTML=html;return node.textContent.trim();};
      if(blankValue(el)!==value.trim()||text(textarea.value)!==value.trim()||(mirror&&text(mirror.innerHTML)!==value.trim()))throw Error('编辑器内容与提交字段尚未同步，未确认填答成功');
      return;
    }
    if(el.isContentEditable)el.textContent=value;
    else Object.getOwnPropertyDescriptor(el.tagName==='TEXTAREA'?HTMLTextAreaElement.prototype:HTMLInputElement.prototype,'value').set.call(el,value);
    el.dispatchEvent(new InputEvent('input',{bubbles:true,inputType:'insertText',data:value}));el.dispatchEvent(new Event('change',{bubbles:true}));
  }
  function scanPractice(){
    const all=queryAll(document,'.TiMu,.questionLi,.question-item,.mark_table,[data-question-id]');
    return all.filter(box=>visible(box)&&!box.closest('.ans-videoquiz')&&!all.some(other=>other!==box&&box.contains(other))).flatMap(box=>{
      const usable=el=>!el.disabled&&!el.readOnly&&el.getAttribute('aria-disabled')!=='true'&&el.getAttribute('aria-readonly')!=='true'&&(visible(el)||visible(el.closest('label')));
      const options=queryAll(box,'input[type="radio"],input[type="checkbox"],[role="radio"],[role="checkbox"]').filter(usable).map((el,i)=>({el,letter:String.fromCharCode(65+i),text:(el.querySelector('.after')?.innerText||el.getAttribute('aria-label')||el.labels?.[0]?.innerText||el.closest('label,li')?.innerText||el.parentElement?.innerText||'').trim()}));
      const blanks=[...queryAll(box,'textarea,input[type="text"],input:not([type]),[contenteditable="true"]').filter(usable),...editorBlanks(box)];
      if((!options.length&&!blanks.length)||options.length>10||blanks.length>20||(options.length&&blanks.length))return [];
      const heading=box.querySelector('.Zy_TItle,.mark_name,.question-title,.stem,[data-question-title]');
      const copy=box.cloneNode(true);queryAll(copy,'textarea,input,[contenteditable="true"]').forEach(el=>el.remove());
      const stem=(heading?.innerText||copy.textContent||'').trim().slice(0,8000);
      const media=queryAll(box,'img,canvas').filter(visible);
      if(!stem&&!media.length)return [];
      const signature=JSON.stringify([stem,options.map(o=>o.text),blanks.length,media.map(el=>el.currentSrc||el.src||`canvas:${el.width}:${el.height}`)]);
      const old=localQuestions.find(q=>q.kind==='practice'&&q.box===box&&q.signature===signature);
      return [{id:old?.id||`p${++quizSerial}`,kind:'practice',box,stem:stem||'图片题',signature,options,blanks,media,encrypted:!!box.querySelector('.font-cxsecret'),
        multiple:options.length>0&&(options.every(o=>o.el.type==='checkbox'||o.el.getAttribute('role')==='checkbox')||/多选|Multiple\s+Choice/i.test(heading?.innerText||'')),
        filled:options.some(optionSelected)||blanks.some(el=>blankValue(el))}];
    });
  }
  function optionSelected(o){
    const el=o.el;
    if(el.checked===true||el.getAttribute('aria-checked')==='true'||el.getAttribute('aria-pressed')==='true')return true;
    const qid=el.getAttribute('qid'),hidden=qid?document.getElementById(`answer${qid}`):null;
    if(!hidden||hidden.type!=='hidden'||!el.closest('.TiMu,.questionLi,.question-item')?.contains(hidden))return false;
    const value=hidden.value.trim(),token=el.querySelector('.num_option[data]')?.getAttribute('data')||o.letter;
    return /^(true|false)$/.test(token)?value===token:/^[A-J]+$/.test(value)&&value.includes(token);
  }
  function setPractice(id,status,message='',response=null){
    practiceStates.set(id,{...practiceStates.get(id),status,message,response:response||practiceStates.get(id)?.response});
    if(tab==='答题')render(true);
  }
  function practiceReply(data){if(isTop)receivePractice(data);else send(parent,data);}
  async function captureRegion(box){
    if(typeof html2canvas!=='function')throw Error('页面渲染库未加载，请更新脚本并检查网络');
    if(!box?.isConnected||!visible(box))throw Error('题目区域已离开页面');
    await document.fonts.ready;
    const bounds=box.getBoundingClientRect(),height=Math.max(bounds.height,box.scrollHeight);
    if(bounds.width<10||height<10||height>20000||bounds.width>6000)throw Error('题目区域尺寸异常');
    const stamp=crypto.randomUUID(),attribute='data-cx-capture';
    const old=box.getAttribute(attribute);box.setAttribute(attribute,stamp);
    try{
      const sourceImages=queryAll(box,'img').filter(visible),images=[];
      for(const img of sourceImages){
        const response=await fetch(img.currentSrc||img.src,{signal:AbortSignal.timeout(12000)});
        if(!response.ok)throw Error('原题图片无法读取');
        const blob=await response.blob();if(blob.size>8*1024*1024)throw Error('原题图片过大');
        images.push(await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=reject;reader.readAsDataURL(blob);}));
      }
      const canvas=await html2canvas(box,{logging:false,backgroundColor:'#fff',scale:Math.min(2,Math.sqrt(16000000/(bounds.width*height))),useCORS:true,allowTaint:false,height,
        ignoreElements:el=>el.id==='cx-study-helper',
        onclone:async doc=>{
